ARG BUN_IMAGE=docker.io/oven/bun:1.3.9
ARG RUNTIME_IMAGE=docker.io/debian:bookworm-slim
ARG PI_VERSION=0.54.1
ARG TAPIR_VCS_REF=unknown
ARG TAPIR_BUILD_VERSION=dev
ARG TAPIR_BUILD_DATE=unknown

FROM ${BUN_IMAGE} AS builder
ARG PI_VERSION

RUN bun add -g "@mariozechner/pi-coding-agent@${PI_VERSION}" \
    && ( /root/.bun/bin/pi --help >/dev/null 2>&1 || true )

FROM ${RUNTIME_IMAGE} AS runtime

ARG APP_DIR=/project
ARG TAPIR_VCS_REF
ARG TAPIR_BUILD_VERSION
ARG TAPIR_BUILD_DATE

LABEL org.opencontainers.image.revision="${TAPIR_VCS_REF}" \
      org.opencontainers.image.version="${TAPIR_BUILD_VERSION}" \
      org.opencontainers.image.created="${TAPIR_BUILD_DATE}"

ENV BUN_INSTALL="/opt/bun/.bun"
ENV BUN_INSTALL_CACHE_DIR="/opt/bun/.bun/install/cache"
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH="/opt/bun/.bun/install/cache/@t@"
ENV TAPIR_BUN_BUNDLED_DIR="/usr/local/bun"
ENV TAPIR_BUILD_COMMIT="${TAPIR_VCS_REF}"
ENV TAPIR_BUILD_VERSION="${TAPIR_BUILD_VERSION}"
ENV TAPIR_BUILD_DATE="${TAPIR_BUILD_DATE}"
ENV PATH="${TAPIR_BUN_BUNDLED_DIR}/bin:/usr/local/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git tmux ripgrep fd-find jq \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/bun /usr/local/bin/bun
COPY --from=builder /root/.bun /usr/local/bun
COPY --from=builder /root/.bun/install/cache /opt/bun/.bun/install/cache
COPY container/entrypoint.sh /usr/local/bin/container-entrypoint.sh

RUN mkdir -p "${BUN_INSTALL_CACHE_DIR}" "${BUN_RUNTIME_TRANSPILER_CACHE_PATH}" /usr/local/share/tapir \
    && chmod -R 0777 /opt/bun \
    && ln -s /usr/local/bin/bun /usr/local/bin/node \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && ln -s /usr/local/bun/install/global/node_modules/@mariozechner/pi-coding-agent/dist/cli.js /usr/local/bin/pi \
    && printf '%s\n' \
      "version=${TAPIR_BUILD_VERSION}" \
      "commit=${TAPIR_VCS_REF}" \
      "created=${TAPIR_BUILD_DATE}" \
      > /usr/local/share/tapir/build-info \
    && printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'printf "tapir version: %s\n" "${TAPIR_BUILD_VERSION:-unknown}"' \
      'printf "tapir commit: %s\n" "${TAPIR_BUILD_COMMIT:-unknown}"' \
      'printf "tapir build date: %s\n" "${TAPIR_BUILD_DATE:-unknown}"' \
      > /usr/local/bin/tapir-version \
    && chmod +x /usr/local/bin/tapir-version /usr/local/bin/container-entrypoint.sh

WORKDIR ${APP_DIR}

ENTRYPOINT ["/usr/local/bin/container-entrypoint.sh"]
CMD ["pi", "--help"]
